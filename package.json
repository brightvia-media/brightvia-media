    "eslint-scope": "^8.3.0",
    "eslint-utils": "^2.1.0",
    "eslint-visitor-keys": "^4.2.0",
    "prettier-linter-helpers": "^1.0.0",
    "typescript-eslint": "^8.20.0"
  },
  "description": "",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
